# /etc/systemd/system/fci-frontend.service: the Next.js server (server-side rendering), built with
# output "standalone" (node server.js). Listens on loopback only; NGINX proxies "/" to it and
# "/api/" to the online Tomcat. Its server-side calls go to the online Tomcat directly (BACKEND_URL).
[Unit]
Description=FCILekha Payroll frontend (Next.js SSR)
After=network-online.target fci-tomcat@online.service
Wants=network-online.target

[Service]
Type=simple
User=fci-web
Group=fci-web
UMask=0027
WorkingDirectory=/opt/fci/web/current
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
# Idle keep-alive (ms) longer than NGINX's upstream keepalive_timeout (15 s): Node's default 5 s closes
# connections NGINX still reuses, and the request then ends in 502.
Environment=KEEP_ALIVE_TIMEOUT=20000
# BACKEND_URL is per environment and lives OUTSIDE the release (owner 2026-11-09): never set it here, a
# deployment that installs this unit would override it. It comes from a web.env file created once per
# server from config/env/web.env.example and never written by a deployment: the DEV layout keeps it in
# /data/fci/frontend/web.env, other servers may use /etc/fci/web.env (a later file overrides an earlier one;
# a leading '-' means "skip if absent"). The server also reads these files itself; with none it refuses
# to start and names the files to create (OD-158; journalctl -u fci-frontend).
EnvironmentFile=-/data/fci/frontend/web.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
