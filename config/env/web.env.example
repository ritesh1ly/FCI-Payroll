# web.env: the per-environment settings of the Next.js web server, kept OUTSIDE the release so that a
# deployment never needs an edit. Put one copy in the environment's config folder (the backend's
# fci.config.dir, e.g. /etc/fci or /data/fci), readable by the user that runs `node server.js`.
# Order the web server uses: the BACKEND_URL variable, then this file. REQUIRED in production (OD-158): without it the web server refuses to start.
# Test the address first:  curl -s "$BACKEND_URL/auth/login-options"   (expects JSON with "otpAtLogin").

# The online backend as the web server reaches it: loopback address, the connector port
# (FCI_HTTP_PORT / -Dfci.http.port) and the context path of the deployed WAR. Not the public URL.
#   DEV server:                http://127.0.0.1:8643/fci-payroll  (the release WAR fci-payroll.war -> /fci-payroll)
BACKEND_URL=http://127.0.0.1:8643/fci-payroll
