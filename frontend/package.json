{
  "name": "fcilekha-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "FCILekha payroll — Next.js with server-side rendering (standalone server behind NGINX); live login and workspace ported",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "npm run generate && next build",
    "start": "node .next/standalone/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run generate && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run generate && vitest run --coverage",
    "test:watch": "vitest",
    "mutation": "npm run generate && stryker run",
    "mutation:shards": "npm run generate && node scripts/mutation-shards.mjs",
    "e2e": "playwright test --project edge",
    "e2e:critical": "playwright test --project edge --workers 1 e2e/01-sign-in-and-access/sign-in.spec.ts e2e/01-sign-in-and-access/login-otp.spec.ts e2e/01-sign-in-and-access/access-control.spec.ts e2e/04-approvals/maker-checker.spec.ts e2e/05-payroll-processing/02b-computation-exceptions.spec.ts e2e/05-payroll-processing/03-payroll-cycle.spec.ts e2e/05-payroll-processing/16-month-end-lock.spec.ts e2e/06-exceptions-and-adjustments/07-cpf-sanction-chain.spec.ts e2e/06-exceptions-and-adjustments/12-tax-statutory.spec.ts e2e/08-employee-payroll/01-hrms-change-approval.spec.ts e2e/08-employee-payroll/04-my-payslips.spec.ts e2e/08-employee-payroll/10-final-settlement.spec.ts e2e/08-employee-payroll/24-pdf-zip-downloads.spec.ts",
    "e2e:browsers": "playwright test --project chrome --project firefox --project webkit --project mobile-safari --project mobile-chrome",
    "e2e:parallel": "node scripts/e2e-parallel.mjs",
    "e2e:lanes": "node scripts/e2e-run.mjs all",
    "e2e:functional": "node scripts/e2e-run.mjs functional",
    "e2e:suite": "node scripts/e2e-run.mjs suite",
    "e2e:domain": "node scripts/e2e-run.mjs domain",
    "e2e:affected": "node scripts/e2e-run.mjs affected",
    "e2e:failed": "node scripts/e2e-run.mjs failed",
    "e2e:manifest": "node scripts/e2e-manifest.mjs",
    "e2e:manifest:check": "node scripts/e2e-manifest.mjs --check",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:i18n && npm run check:e2e-trace && npm run test",
    "check:static": "npm run typecheck && npm run lint && npm run format:check && npm run check:i18n && npm run check:e2e-trace",
    "generate": "node scripts/build-i18n.mjs && node scripts/build-wireframes.mjs",
    "predev": "npm run generate",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:e2e-trace": "node scripts/check-e2e-trace.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@tanstack/react-query": "5.104.2",
    "geist": "1.7.2",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.4.1",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.0.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "overrides": {
    "undici": "8.12.2"
  }
}
